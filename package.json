{
  "name": "studietracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "demo": "tsx scripts/demo.ts sleutel --als-nodig && npm run build && vite preview --host",
    "demo:sleutel": "tsx scripts/demo.ts sleutel",
    "sleutel:nieuw": "tsx scripts/demo.ts nieuw",
    "code": "tsx scripts/demo.ts code",
    "curriculum": "tsx scripts/importeer-curriculum.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
